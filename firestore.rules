rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get partnership ID (sorted)
    function getPartnershipId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1;
    }

    // Check if user is a member of the library (owner or partner)
    function isLibraryMember(userId, libraryOwnerId) {
      return userId == libraryOwnerId ||
             exists(path('/databases/' + database + '/documents/partnerships/' + getPartnershipId(userId, libraryOwnerId)));
    }

    // Check if user has edit permissions in the library
    function canEditLibrary(userId, libraryOwnerId) {
      return userId == libraryOwnerId || (
        exists(path('/databases/' + database + '/documents/partnerships/' + getPartnershipId(userId, libraryOwnerId))) &&
        get(path('/databases/' + database + '/documents/partnerships/' + getPartnershipId(userId, libraryOwnerId))).data.get('allowAddBooks', false) == true
      );
    }

    // ========== USERS COLLECTION ==========
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // ========== PARTNERSHIPS COLLECTION ==========
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId1 || 
         request.auth.uid == resource.data.userId2);
         
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.userId1 ||
         request.auth.uid == request.resource.data.userId2);
         
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.userId1 || 
         request.auth.uid == resource.data.userId2);
         
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId1 || 
         request.auth.uid == resource.data.userId2);

      match /lounge/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.userId1 == request.auth.uid ||
          get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.userId2 == request.auth.uid
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.userId1 == request.auth.uid ||
          get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.userId2 == request.auth.uid
        ) && request.resource.data.userId == request.auth.uid;
      }
    }

    // Support for Collection Group queries for lounge messages
    match /{path=**}/lounge/{messageId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/partnerships/$(path[path.size()-1])).data.userId1 == request.auth.uid ||
        get(/databases/$(database)/documents/partnerships/$(path[path.size()-1])).data.userId2 == request.auth.uid
      );
    }

    // ========== BOOKS COLLECTION ==========
    match /books/{bookId} {
      // Allow read if user is the owner or a partner
      allow read: if request.auth != null &&
        isLibraryMember(request.auth.uid, resource.data.userId);
      
      allow create: if request.auth != null &&
        canEditLibrary(request.auth.uid, request.resource.data.userId);

      allow update, delete: if request.auth != null &&
        canEditLibrary(request.auth.uid, resource.data.userId);
    }

    // ========== READING STATUS SUBCOLLECTION (supports Collection Group) ==========
    match /{path=**}/readingStatus/{statusId} {
      allow read: if request.auth != null && (
        request.auth.uid == statusId ||
        (resource != null && request.auth.uid == resource.data.userId) ||
        isLibraryMember(request.auth.uid, get(/databases/$(database)/documents/$(path)).data.userId)
      );
      allow write: if request.auth != null && request.auth.uid == statusId;
    }

    // ========== ACTIVITY FEED COLLECTION ==========
    match /activityFeed/{activityId} {
      allow read: if request.auth != null &&
        isLibraryMember(request.auth.uid, resource.data.libraryId);
      
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId &&
        isLibraryMember(request.auth.uid, request.resource.data.libraryId)
      );

      allow update, delete: if false;
    }

    // ========== REVIEWS COLLECTION ==========
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }
  }
}
