rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPERS
    // ==========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getPartnershipId(uid1, uid2) {
      return uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1;
    }

function partnershipExists(uid1, uid2) {
  return get(/databases/$(database)/documents/partnerships/$(getPartnershipId(uid1, uid2))).data.status == 'accepted';
}

function partnershipAllowsAdd(uid1, uid2) {
  let p = get(/databases/$(database)/documents/partnerships/$(getPartnershipId(uid1, uid2)));
  return p.data.status == 'accepted'
    && p.data.allowAddBooks == true
    // A grant must exist, and only the library owner (uid2) can be the granter.
    && p.data.grantedBy != ''
    && p.data.grantedBy == uid2;
}
    function isLibraryMember(userId, libraryOwnerId) {
      return userId == libraryOwnerId || partnershipExists(userId, libraryOwnerId);
    }

    function canEditLibrary(userId, libraryOwnerId) {
      return userId == libraryOwnerId || partnershipAllowsAdd(userId, libraryOwnerId);
    }

    // ==========================================================
    // USERS — public parent + private subcollection
    // ==========================================================
    match /users/{userId} {
      // Anyone signed-in can see the public profile.
      allow read: if isSignedIn();

      // Only the owner can create/update their own doc.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;

      // Private data — owner only.
      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ==========================================================
    // USER LOOKUP (email → uid) for collaborator search
    // ==========================================================
    match /userLookup/{email} {
      allow read: if isSignedIn();

      // Denies email squatting in userLookup — a caller may only claim their own verified email.
      allow create: if isSignedIn()
        && request.auth.token.email != null
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower()
        && email == email.lower()
        && email.matches('^[^@]+@[^@]+$');

      // Denies email squatting in userLookup — a caller may only claim their own verified email.
      allow update: if isSignedIn()
        && request.auth.token.email != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();

      allow delete: if false;
    }

    // ==========================================================
    // PARTNERSHIPS — created only after an accepted request exists
    // ==========================================================
    match /partnerships/{partnershipId} {
      // Split reads for list-query provability.
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId1;
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId2;

      allow create: if isSignedIn()
        && (request.auth.uid == request.resource.data.userId1
            || request.auth.uid == request.resource.data.userId2)
        // Must use the canonical sorted-UID pair as the ID.
        && partnershipId == getPartnershipId(
              request.resource.data.userId1,
              request.resource.data.userId2
           )
        // An accepted collaboration request must already exist.
        && exists(/databases/$(database)/documents/collaborationRequests/$(partnershipId))
        && get(/databases/$(database)/documents/collaborationRequests/$(partnershipId)).data.status == 'accepted'
        // Fresh partnerships start closed.
        && request.resource.data.status == 'accepted'
        && request.resource.data.allowAddBooks == false
        // No add-books grant exists until a party explicitly grants it.
        && request.resource.data.grantedBy == '';

      // Guards allowAddBooks so a partner cannot self-grant write access to the other's library.
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.userId1
            || request.auth.uid == resource.data.userId2)
        && request.resource.data.userId1 == resource.data.userId1
        && request.resource.data.userId2 == resource.data.userId2
        && request.resource.data.status == resource.data.status
        && (
          // Grant on: the library owner turns allowAddBooks on and records themselves as granter.
          (resource.data.allowAddBooks == false
           && request.resource.data.allowAddBooks == true
           && request.resource.data.grantedBy == request.auth.uid)
          // Revoke: allowAddBooks turns off and the grant is reset.
          || (resource.data.allowAddBooks == true
              && request.resource.data.allowAddBooks == false
              && request.resource.data.grantedBy == '')
          // Unchanged: the recorded granter must not change.
          // Uses .get() with a default so legacy docs that predate grantedBy can be migrated.
          || (request.resource.data.allowAddBooks == resource.data.allowAddBooks
              && request.resource.data.get('grantedBy', '') == resource.data.get('grantedBy', ''))
        )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['allowAddBooks', 'user1Unsubscribed', 'user2Unsubscribed', 'updatedAt', 'grantedBy']);

      allow delete: if false;
    }

    // ==========================================================
    // COLLABORATION REQUESTS — deterministic ID = sorted UID pair
    // ==========================================================
    match /collaborationRequests/{requestId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.fromUserId;
      allow read: if isSignedIn() && request.auth.uid == resource.data.toUserId;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == 'pending'
        && requestId == getPartnershipId(
              request.resource.data.fromUserId,
              request.resource.data.toUserId
           );

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.toUserId
            || request.auth.uid == resource.data.fromUserId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ==========================================================
    // BOOKS
    // ==========================================================
match /books/{bookId} {
  // Own books — provable from `where('userId','==',uid)`.
  allow read: if isSignedIn() && request.auth.uid == resource.data.userId;

  // Partner books — path is deterministic given `resource.data.userId`.
  // Now respects unsubscribe flags.
  allow read: if isSignedIn()
    && get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.userId))).data.status == 'accepted'
    && (
      (get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.userId))).data.userId1 == request.auth.uid
        && get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.userId))).data.get('user1Unsubscribed', false) != true)
      ||
      (get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.userId))).data.userId2 == request.auth.uid
        && get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.userId))).data.get('user2Unsubscribed', false) != true)
    );

  // Validates book payload sizes, copyType, and coverUrl scheme.
  allow create: if isSignedIn()
    && canEditLibrary(request.auth.uid, request.resource.data.userId)
    && request.resource.data.title is string
    && request.resource.data.author is string
    && request.resource.data.title.size() <= 500
    && request.resource.data.author.size() <= 300
    && (!('description' in request.resource.data) || request.resource.data.description.size() <= 10000)
    && (!('isbn'        in request.resource.data) || request.resource.data.isbn.size() <= 40)
    && (!('coverUrl'    in request.resource.data) || (
         request.resource.data.coverUrl.size() <= 2000
         && request.resource.data.coverUrl.matches('^https?://')
       ))
    && (!('tags'        in request.resource.data) || request.resource.data.tags.size() <= 50)
    && (!('categories'  in request.resource.data) || request.resource.data.categories.size() <= 20)
    && (!('copyType' in request.resource.data) || request.resource.data.copyType in ['New Copy','Old Copy','Gifted']);

  // Same validations for updates, plus ownership transfer logic.
  allow update: if isSignedIn()
    && canEditLibrary(request.auth.uid, resource.data.userId)
    && request.resource.data.title is string
    && request.resource.data.author is string
    && request.resource.data.title.size() <= 500
    && request.resource.data.author.size() <= 300
    && (!('description' in request.resource.data) || request.resource.data.description.size() <= 10000)
    && (!('isbn'        in request.resource.data) || request.resource.data.isbn.size() <= 40)
    && (!('coverUrl'    in request.resource.data) || (
         request.resource.data.coverUrl.size() <= 2000
         && request.resource.data.coverUrl.matches('^https?://')
       ))
    && (!('tags'        in request.resource.data) || request.resource.data.tags.size() <= 50)
    && (!('categories'  in request.resource.data) || request.resource.data.categories.size() <= 20)
    && (!('copyType' in request.resource.data) || request.resource.data.copyType in ['New Copy','Old Copy','Gifted'])
    && (
      // Normal update — ownership unchanged.
      request.resource.data.userId == resource.data.userId
      // Owner transferring the book to someone with edit permission on them.
      || (resource.data.userId == request.auth.uid
          && canEditLibrary(request.auth.uid, request.resource.data.userId))
    );

  allow delete: if isSignedIn()
    && canEditLibrary(request.auth.uid, resource.data.userId);
}

    // ==========================================================
    // READING STATUS (collection group)
    // ==========================================================
    match /{path=**}/readingStatus/{statusId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Validates reading status, comment, and gifter name to reject malformed writes.
      allow write: if isSignedIn()
        && request.auth.uid == statusId
        && request.resource.data.userId == request.auth.uid
        // Optional range validation — only applies if the field is present.
        && (request.resource.data.rating == null
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 0
                && request.resource.data.rating <= 5))
        && (request.resource.data.progress == null
            || (request.resource.data.progress is int
                && request.resource.data.progress >= 0
                && request.resource.data.progress <= 100))
        && request.resource.data.status in ['want_to_read','reading','finished']
        && (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 2000)
        && (!('gifterName' in request.resource.data) || request.resource.data.gifterName.size() <= 200);
    }

    // ==========================================================
    // ACTIVITY FEED
    // ==========================================================
    match /activityFeed/{activityId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.libraryId;
  allow read: if isSignedIn()
    && get(/databases/$(database)/documents/partnerships/$(getPartnershipId(request.auth.uid, resource.data.libraryId))).data.status == 'accepted';

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && canEditLibrary(request.auth.uid, request.resource.data.libraryId);

      allow update, delete: if false;
    }

    // ==========================================================
    // BOOK REQUESTS (borrowing)
    // ==========================================================
    match /bookRequests/{requestId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.fromUserId;
      allow read: if isSignedIn() && request.auth.uid == resource.data.toUserId;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && (
          // Recipient accepts or rejects.
          (request.auth.uid == resource.data.toUserId
           && request.resource.data.status in ['accepted', 'rejected'])
          ||
          // Sender cancels.
          (request.auth.uid == resource.data.fromUserId
           && request.resource.data.status == 'cancelled')
        );

      allow delete: if false;
    }

    // ==========================================================
    // REVIEWS
    // ==========================================================
    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category in ['Help', 'Review', 'Others']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 2000
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0;

      allow update: if isSignedIn() && (
        // Owner editing review content.
        (resource.data.userId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['body', 'rating', 'category', 'updatedAt']))
        ||
        // Counters (likesCount/commentsCount) — a signed-in user may change either counter
        // by exactly +1 or -1 per write. This blocks the "set likesCount to 999999" attack
        // while keeping the existing like/comment UI functional.
        // TODO: replace with a Cloud Function that increments on writes to /likes and /comments.
        (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likesCount', 'commentsCount'])
         && (request.resource.data.likesCount == resource.data.likesCount
             || request.resource.data.likesCount == resource.data.likesCount + 1
             || request.resource.data.likesCount == resource.data.likesCount - 1)
         && (request.resource.data.commentsCount == resource.data.commentsCount
             || request.resource.data.commentsCount == resource.data.commentsCount + 1
             || request.resource.data.commentsCount == resource.data.commentsCount - 1))
      );

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}