rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function currentEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActivePartnership(id) {
      return exists(/databases/$(database)/documents/partnerships/$(id))
        && get(/databases/$(database)/documents/partnerships/$(id)).data.status == 'accepted'
        && get(/databases/$(database)/documents/partnerships/$(id)).data.user1Unsubscribed == false
        && get(/databases/$(database)/documents/partnerships/$(id)).data.user2Unsubscribed == false;
    }

    function isActivePartner(otherUid) {
      return isSignedIn()
        && (
          isActivePartnership(request.auth.uid + '_' + otherUid)
          || isActivePartnership(otherUid + '_' + request.auth.uid)
        );
    }

    function areActivePartners(userA, userB) {
      let directId = userA + '_' + userB;
      let reverseId = userB + '_' + userA;
      return (
        isActivePartnership(directId)
        && get(/databases/$(database)/documents/partnerships/$(directId)).data.userId1
          in [userA, userB]
        && get(/databases/$(database)/documents/partnerships/$(directId)).data.userId2
          in [userA, userB]
      ) || (
        isActivePartnership(reverseId)
        && get(/databases/$(database)/documents/partnerships/$(reverseId)).data.userId1
          in [userA, userB]
        && get(/databases/$(database)/documents/partnerships/$(reverseId)).data.userId2
          in [userA, userB]
      );
    }
    function postVisibility(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId))
        ? getAfter(/databases/$(database)/documents/users/$(userId))
            .data.privacySettings.get('posts', 'public')
        : 'private';
    }

    function canReadPosts(post) {
      return isAdmin()
        || (isSignedIn() && post.get('userId', '') == request.auth.uid)
        || post.get('visibility', 'public') == 'public'
        || (isSignedIn() && post.get('visibility', 'public') == 'signed_in')
        || (isSignedIn()
          && post.get('visibility', 'public') == 'followers_collaborators'
          && (
            exists(/databases/$(database)/documents/users/$(post.userId)/followers/$(request.auth.uid))
            || isActivePartner(post.userId)
          ));
    }

    function canReadReview(reviewId) {
      return exists(/databases/$(database)/documents/reviews/$(reviewId))
        && canReadPosts(get(/databases/$(database)/documents/reviews/$(reviewId)).data);
    }

    function hasCurrentPostVisibility(userId, data) {
      return (data.keys().hasAny(['visibility'])
          && data.visibility == postVisibility(userId))
        || (!data.keys().hasAny(['visibility'])
          && postVisibility(userId) == 'public');
    }

    // The library owner grants the permission; `grantedBy` holds the owner's
    // uid, not the uid of the collaborator who performs the add.
    function hasAddGrant(id, ownerUid) {
      return exists(/databases/$(database)/documents/partnerships/$(id))
        && get(/databases/$(database)/documents/partnerships/$(id)).data.allowAddBooks == true
        && get(/databases/$(database)/documents/partnerships/$(id)).data.grantedBy == ownerUid;
    }

    function canAddToPartnerLibrary(ownerUid) {
      return isActivePartner(ownerUid)
        && (
          hasAddGrant(request.auth.uid + '_' + ownerUid, ownerUid)
          || hasAddGrant(ownerUid + '_' + request.auth.uid, ownerUid)
        );
    }

    function boundedByOne(previous, next) {
      return next == previous || next == previous + 1 || next == previous - 1;
    }

    function borrowPermission(ownerUid) {
      return get(/databases/$(database)/documents/users/$(ownerUid))
        .data.privacySettings.get('borrowRequestPermission', 'collaborators');
    }

    function mayRequestBorrow(ownerUid) {
      return isSignedIn()
        && request.auth.uid != ownerUid
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && (
          borrowPermission(ownerUid) == 'anyone'
          || (borrowPermission(ownerUid) == 'collaborators'
            && isActivePartner(ownerUid))
          || (borrowPermission(ownerUid) == 'collaborators_followers'
            && (
              isActivePartner(ownerUid)
              || exists(/databases/$(database)/documents/users/$(ownerUid)/followers/$(request.auth.uid))
            ))
        );
    }

    function requesterHasLendingInfo() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('contractNumber', '') is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('contractNumber', '').size() > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('contractNumber', '').matches('.*\\S.*')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('address', '') is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('address', '').size() > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data)
          .data.get('address', '').matches('.*\\S.*');
    }

    function bookIsAvailable(book) {
      return book.get('borrowStatus', 'available') == 'available'
        && book.get('borrowRequestId', null) == null
        && book.get('activeLoanId', null) == null
        && book.get('borrowedBy', null) == null;
    }

    function requestInAfter(requestId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/bookRequests/$(requestId))
        && getAfter(/databases/$(database)/documents/bookRequests/$(requestId)).data.status
          == expectedStatus;
    }

    function loanInAfter(loanId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/loans/$(loanId))
        && getAfter(/databases/$(database)/documents/loans/$(loanId)).data.status
          == expectedStatus;
    }

    // ---------------------------------------------------------------
    // users/{userId}
    // ---------------------------------------------------------------

    match /users/{userId} {
      // Legacy docs created before Phase 5.1 may lack `role`/`plan`. When the
      // field is missing on the stored doc, allow the update if it stays missing
      // or is backfilled with its default; otherwise the value stays frozen.
      function roleAllowed() {
        return (resource.data.keys().hasAll(['role'])
            && request.resource.data.keys().hasAll(['role'])
            && request.resource.data.role == resource.data.role)
          || (!resource.data.keys().hasAll(['role'])
            && (!request.resource.data.keys().hasAll(['role'])
              || request.resource.data.role == 'user'));
      }

      function planAllowed() {
        return (resource.data.keys().hasAll(['plan'])
            && request.resource.data.keys().hasAll(['plan'])
            && request.resource.data.plan == resource.data.plan)
          || (!resource.data.keys().hasAll(['plan'])
            && (!request.resource.data.keys().hasAll(['plan'])
              || request.resource.data.plan == 'free'));
      }

      // Public profile docs are world-readable by uid so that guests can view
      // /u/:username. Usernames are resolved through usernameLookup. The public
      // doc intentionally contains no email (see users/{uid}/private/data).
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.plan == 'free';

      // FIX: also freeze the uid field so it can't be rewritten.
      allow update: if isSignedIn() && (
        (
          userId == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && roleAllowed()
          && planAllowed()
        )
        // A follower may only move followerCount by one, and only together
        // with the matching followers/{uid} doc (proven via existsAfter).
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
          && request.resource.data.followerCount is number
          && request.resource.data.followerCount >= 0
          && (
            (
              !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              && (
                (!resource.data.keys().hasAll(['followerCount'])
                  && request.resource.data.followerCount == 1)
                || (resource.data.keys().hasAll(['followerCount'])
                  && request.resource.data.followerCount == resource.data.followerCount + 1)
              )
            )
            || (
              exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              && resource.data.keys().hasAll(['followerCount'])
              && request.resource.data.followerCount == resource.data.followerCount - 1
            )
          )
        )
        // Admins may change role, plan, banned, bannedReason, and bannedAt.
        || isAdmin()
      );

      allow delete: if isSignedIn() && (userId == request.auth.uid || isAdmin());

      match /private/{documentId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }

      // Follow graph. followers is public (counts live on the public profile
      // doc); following is private to its owner.
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isSignedIn()
          && followerId == request.auth.uid
          && userId != request.auth.uid;
        allow delete: if isSignedIn() && followerId == request.auth.uid;
      }

      match /following/{followedId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && followedId != request.auth.uid;
        allow delete: if isSignedIn() && userId == request.auth.uid;
      }

      // Notifications are written by other users (the actor) into the recipient's
      // subcollection, but only the recipient can read, update, or delete them.
match /notifications/{notifId} {
  allow read: if isSignedIn() && request.auth.uid == userId;

  allow create: if isSignedIn()
    && request.resource.data.actorUserId == request.auth.uid
    && request.resource.data.keys().hasAll(['title', 'body'])
    && request.resource.data.title is string
    && request.resource.data.title.size() <= 200
    && request.resource.data.body is string
    && request.resource.data.body.size() <= 500
    && (!request.resource.data.keys().hasAny(['link'])
      || request.resource.data.link == null
      || (request.resource.data.link is string
        && request.resource.data.link.size() <= 500));

  allow update, delete: if isSignedIn() && request.auth.uid == userId;
}

      // Push registration tokens — private to their owner. The trusted backend
      // reads them (Admin SDK) to deliver notifications.
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // User notes — private notepad notes subcollection.
      match /notes/{noteId} {
        function isValidNote() {
          return request.resource.data.content is string
            && request.resource.data.content.size() <= 50000
            && (!request.resource.data.keys().hasAny(['title'])
              || request.resource.data.title == null
              || (request.resource.data.title is string
                && request.resource.data.title.size() <= 1000));
        }

        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && isValidNote();
      }
    }

    // ---------------------------------------------------------------
    // userLookup/{email}
    // ---------------------------------------------------------------

    match /userLookup/{email} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 1;

      allow create, update: if isSignedIn()
        && currentEmail() != ''
        && email == currentEmail()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn() && (email == currentEmail() || isAdmin());
    }

    // ---------------------------------------------------------------
    // usernameLookup/{username} — lowercase username -> { uid, ... }
    // ---------------------------------------------------------------

    match /usernameLookup/{username} {
      allow get: if true;
      allow list: if request.query.limit <= 10;

      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // books/{bookId}
    // ---------------------------------------------------------------

    match /books/{bookId} {
      function isBookOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isCurrentBorrower() {
        return isSignedIn()
          && resource.data.get('borrowedBy', '') == request.auth.uid;
      }

      function ownerLibraryPrivacy() {
        let userPath = /databases/$(database)/documents/users/$(resource.data.userId);
        return exists(userPath)
          && get(userPath).data.keys().hasAll(['privacySettings'])
          && get(userPath).data.privacySettings is map
          ? get(userPath).data.privacySettings.get('library', 'private')
          : 'private';
      }

      function isPartnerOfOwner() {
        return isSignedIn()
          && resource.data.userId != request.auth.uid
          && isActivePartner(resource.data.userId)
          && ownerLibraryPrivacy() in ['public', 'collaborators'];
      }

      // A book becomes world-readable when its owner has published their
      // library. Collaborators are covered by isPartnerOfOwner().
      function isOwnerLibraryPublic() {
        return ownerLibraryPrivacy() == 'public';
      }

      function isValidBook() {
        return request.resource.data.keys().hasAll(['userId', 'title', 'author', 'createdAt', 'updatedAt'])
          && request.resource.data.userId is string
          && request.resource.data.title is string
          && request.resource.data.author is string
          && request.resource.data.title.size() > 0
          && request.resource.data.author.size() > 0
          && (!request.resource.data.keys().hasAny(['isInLibrary'])
            || request.resource.data.isInLibrary is bool);
      }

      function changesLoanManagedFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'borrowedBy',
          'borrowDate',
          'borrowHistory',
          'borrowStatus',
          'borrowRequestId',
          'activeLoanId'
        ]);
      }

      function requestBookLock() {
        let requestId = request.resource.data.borrowRequestId;
        let requestData = getAfter(
          /databases/$(database)/documents/bookRequests/$(requestId)
        ).data;
        return isSignedIn()
          && resource.data.userId == requestData.toUserId
          && request.auth.uid == requestData.fromUserId
          && bookIsAvailable(resource.data)
          && requestData.status == 'pending'
          && requestData.bookId == bookId
          && request.resource.data.borrowStatus == 'pending_request'
          && request.resource.data.borrowRequestId == requestId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['borrowStatus', 'borrowRequestId', 'updatedAt']);
      }

      function updatePendingRequestBookState() {
        let requestId = resource.data.borrowRequestId;
        let afterRequest = getAfter(
          /databases/$(database)/documents/bookRequests/$(requestId)
        ).data;
        return request.auth.uid == resource.data.userId
          && afterRequest.toUserId == request.auth.uid
          && afterRequest.bookId == bookId
          && (
            (afterRequest.status == 'accepted_waiting_confirmation'
              && request.resource.data.borrowStatus == 'accepted_waiting_confirmation'
              && request.resource.data.borrowRequestId == requestId)
            || (afterRequest.status == 'rejected'
              && request.resource.data.borrowStatus == 'available'
              && request.resource.data.borrowRequestId == null)
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['borrowStatus', 'borrowRequestId', 'updatedAt']);
      }

      function cancelWaitingBookState() {
        let requestId = resource.data.borrowRequestId;
        let afterRequest = getAfter(
          /databases/$(database)/documents/bookRequests/$(requestId)
        ).data;
        return afterRequest.status == 'cancelled'
          && request.auth.uid in [afterRequest.fromUserId, afterRequest.toUserId]
          && request.resource.data.borrowStatus == 'available'
          && request.resource.data.borrowRequestId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['borrowStatus', 'borrowRequestId', 'updatedAt']);
      }

      function activateLoan() {
        let requestId = resource.data.borrowRequestId;
        let afterRequest = getAfter(
          /databases/$(database)/documents/bookRequests/$(requestId)
        ).data;
        let afterLoan = getAfter(
          /databases/$(database)/documents/loans/$(requestId)
        ).data;
        return request.auth.uid == afterRequest.fromUserId
          && afterRequest.status == 'active'
          && afterLoan.status == 'active'
          && afterLoan.ownerId == resource.data.userId
          && afterLoan.borrowerId == request.auth.uid
          && afterLoan.bookId == bookId
          && request.resource.data.borrowStatus == 'on_loan'
          && request.resource.data.borrowRequestId == requestId
          && request.resource.data.activeLoanId == requestId
          && request.resource.data.borrowedBy == request.auth.uid
          && request.resource.data.borrowDate == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'borrowStatus',
              'borrowRequestId',
              'activeLoanId',
              'borrowedBy',
              'borrowDate',
              'borrowHistory',
              'updatedAt'
            ]);
      }

      function requestLoanReturn() {
        let loanId = resource.data.activeLoanId;
        let afterLoan = getAfter(
          /databases/$(database)/documents/loans/$(loanId)
        ).data;
        return request.auth.uid == afterLoan.borrowerId
          && afterLoan.status == 'return_pending_confirmation'
          && afterLoan.bookId == bookId
          && request.resource.data.borrowStatus == 'return_pending_confirmation'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['borrowStatus', 'updatedAt']);
      }

      function confirmLoanReturn() {
        let loanId = resource.data.activeLoanId;
        let afterLoan = getAfter(
          /databases/$(database)/documents/loans/$(loanId)
        ).data;
        return request.auth.uid == resource.data.userId
          && afterLoan.ownerId == request.auth.uid
          && afterLoan.status == 'returned'
          && request.resource.data.borrowStatus == 'available'
          && request.resource.data.borrowRequestId == null
          && request.resource.data.activeLoanId == null
          && request.resource.data.borrowedBy == null
          && request.resource.data.borrowDate == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'borrowStatus',
              'borrowRequestId',
              'activeLoanId',
              'borrowedBy',
              'borrowDate',
              'borrowHistory',
              'updatedAt'
            ]);
      }

      allow read: if isBookOwner()
        || isCurrentBorrower()
        || isPartnerOfOwner()
        || isOwnerLibraryPublic();

      allow create: if isSignedIn()
        && isValidBook()
        && request.resource.data.get('borrowedBy', null) == null
        && request.resource.data.get('borrowDate', null) == null
        && request.resource.data.get('borrowStatus', 'available') == 'available'
        && request.resource.data.get('borrowRequestId', null) == null
        && request.resource.data.get('activeLoanId', null) == null
        && (
          request.resource.data.userId == request.auth.uid
          || canAddToPartnerLibrary(request.resource.data.userId)
        );

      // Loan state changes are allowed only alongside the matching request/loan transition.
      allow update: if isSignedIn()
        && isValidBook()
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (requestBookLock())
          || (resource.data.borrowStatus == 'pending_request'
            && updatePendingRequestBookState())
          || (resource.data.borrowStatus == 'accepted_waiting_confirmation'
            && cancelWaitingBookState())
          || (resource.data.borrowStatus == 'accepted_waiting_confirmation'
            && activateLoan())
          || (resource.data.borrowStatus == 'on_loan' && requestLoanReturn())
          || (resource.data.borrowStatus == 'return_pending_confirmation'
            && confirmLoanReturn())
          || (!changesLoanManagedFields()
            && request.resource.data.userId == resource.data.userId
            && (isBookOwner() || canAddToPartnerLibrary(resource.data.userId)))
          || (isBookOwner()
            && resource.data.get('borrowRequestId', null) == null
            && resource.data.get('activeLoanId', null) == null
            && resource.data.get('borrowedBy', null) == null
            && request.resource.data.userId != resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userId', 'updatedAt']))
        );

      allow delete: if isSignedIn()
        && resource.data.get('borrowRequestId', null) == null
        && resource.data.get('activeLoanId', null) == null
        && resource.data.get('borrowedBy', null) == null
        && (
          isBookOwner()
          || canAddToPartnerLibrary(resource.data.userId)
          || isAdmin()
        );
    }

    // ---------------------------------------------------------------
    // readingStatus — collection-group safe
    // ---------------------------------------------------------------

    match /{path=**}/readingStatus/{statusUid} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow write: if isSignedIn()
        && statusUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // partnerships
    // ---------------------------------------------------------------

    match /partnerships/{partnershipId} {
      // A participant may read the partnership. The request-book flow reads both
      // "<a>_<b>" orderings of the id to locate the pair, so one of them is
      // always absent; dereferencing the null `resource` would otherwise deny
      // that read and abort the whole transaction with permission-denied.
      allow read: if isSignedIn()
        && (resource == null
          || resource.data.userId1 == request.auth.uid
          || resource.data.userId2 == request.auth.uid);

      // FIX: require an accepted collaborationRequest from the OTHER party.
      // Only the recipient of an accepted request can create the partnership.
      // getAfter() is required because the request is flipped to 'accepted' in
      // the same writeBatch that creates this partnership.
      allow create: if isSignedIn()
        && (request.resource.data.userId1 == request.auth.uid
          || request.resource.data.userId2 == request.auth.uid)
        && getAfter(/databases/$(database)/documents/collaborationRequests/$(partnershipId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/collaborationRequests/$(partnershipId)).data.toUserId == request.auth.uid
        && getAfter(/databases/$(database)/documents/collaborationRequests/$(partnershipId)).data.fromUserId in
             [request.resource.data.userId1, request.resource.data.userId2]
        && getAfter(/databases/$(database)/documents/collaborationRequests/$(partnershipId)).data.toUserId in
             [request.resource.data.userId1, request.resource.data.userId2];

      allow update: if isSignedIn()
        && (resource.data.userId1 == request.auth.uid || resource.data.userId2 == request.auth.uid)
        && (request.resource.data.userId1 == resource.data.userId1
          && request.resource.data.userId2 == resource.data.userId2);

      allow delete: if isSignedIn()
        && (resource.data.userId1 == request.auth.uid
          || resource.data.userId2 == request.auth.uid
          || isAdmin());
    }

    // ---------------------------------------------------------------
    // collaborationRequests
    // ---------------------------------------------------------------

    match /collaborationRequests/{requestId} {
      // A participant may read the request doc. The inviter checks for an existing
      // request BEFORE creating one, so the doc is often absent; dereferencing the
      // null `resource` would otherwise deny that check with permission-denied.
      allow read: if isSignedIn()
        && (resource == null
          || resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);

      // FIX: pin both fromUserId and toUserId, and require pending on create.
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == 'pending';

      // FIX: restrict updates to status only and pin participants.
      allow update: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid)
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // bookRequests
    // ---------------------------------------------------------------

    match /bookRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.contactInfoShared == false
        && request.resource.data.keys().hasAll([
          'fromUserId',
          'toUserId',
          'bookId',
          'bookTitle',
          'requesterName',
          'requesterUsername',
          'ownerName',
          'ownerUsername',
          'status',
          'contactInfoShared',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'bookId',
          'bookTitle',
          'requesterName',
          'requesterUsername',
          'ownerName',
          'ownerUsername',
          'status',
          'contactInfoShared',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.bookId is string
        && request.resource.data.bookTitle is string
        && request.resource.data.bookTitle.size() > 0
        && mayRequestBorrow(request.resource.data.toUserId)
        && requesterHasLendingInfo()
        && exists(/databases/$(database)/documents/books/$(request.resource.data.bookId))
        && get(/databases/$(database)/documents/books/$(request.resource.data.bookId))
          .data.userId == request.resource.data.toUserId
        && bookIsAvailable(
          get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data
        )
        && existsAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId))
        && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId))
          .data.borrowStatus == 'pending_request'
        && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId))
          .data.borrowRequestId == requestId;

      function ownerAccepts() {
        let ownerPrivatePath = /databases/$(database)/documents/users/$(request.auth.uid)/private/data;
        return request.auth.uid == resource.data.toUserId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted_waiting_confirmation'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/books/$(resource.data.bookId))
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowStatus == 'accepted_waiting_confirmation'
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowRequestId == requestId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'acceptedAt',
              'updatedAt',
              'contactInfoShared',
              'ownerPhoneNumber',
              'ownerAddress'
            ])
          && (
            (request.resource.data.contactInfoShared == false
              && !request.resource.data.keys().hasAny(['ownerPhoneNumber', 'ownerAddress']))
            || (request.resource.data.contactInfoShared == true
              && exists(ownerPrivatePath)
              && request.resource.data.ownerPhoneNumber
                == get(ownerPrivatePath).data.get('phoneNumber', '')
              && request.resource.data.ownerAddress
                == get(ownerPrivatePath).data.get('address', ''))
          );
      }

      function ownerRejects() {
        return request.auth.uid == resource.data.toUserId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'rejected'
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowStatus == 'available'
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowRequestId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']);
      }

      function waitingHandoverCancelled() {
        return resource.data.status == 'accepted_waiting_confirmation'
          && request.auth.uid in [resource.data.fromUserId, resource.data.toUserId]
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowStatus == 'available'
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowRequestId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt']);
      }

      function borrowerConfirmsReceipt() {
        return resource.data.status == 'accepted_waiting_confirmation'
          && request.auth.uid == resource.data.fromUserId
          && request.resource.data.status == 'active'
          && request.resource.data.confirmedAt == request.time
          && request.resource.data.updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/loans/$(requestId))
          && getAfter(/databases/$(database)/documents/loans/$(requestId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.activeLoanId == requestId
          && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
            .data.borrowStatus == 'on_loan'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'confirmedAt', 'updatedAt']);
      }

      allow update: if isSignedIn()
        && (
          ownerAccepts()
          || ownerRejects()
          || waitingHandoverCancelled()
          || borrowerConfirmsReceipt()
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // loans — source of truth for all confirmed lending relationships
    // ---------------------------------------------------------------

    match /loans/{loanId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.borrowerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.requestId == loanId
        && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/bookRequests/$(loanId))
        && get(/databases/$(database)/documents/bookRequests/$(loanId)).data.status
          == 'accepted_waiting_confirmation'
        && get(/databases/$(database)/documents/bookRequests/$(loanId)).data.fromUserId
          == request.auth.uid
        && request.resource.data.bookId
          == get(/databases/$(database)/documents/bookRequests/$(loanId)).data.bookId
        && request.resource.data.ownerId
          == get(/databases/$(database)/documents/bookRequests/$(loanId)).data.toUserId
        && requestInAfter(loanId, 'active')
        && existsAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId))
        && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId))
          .data.activeLoanId == loanId
        && existsAfter(/databases/$(database)/documents/loanCounters/$(request.time.year()))
        && getAfter(/databases/$(database)/documents/loanCounters/$(request.time.year()))
          .data.lastRequestId == loanId
        && request.resource.data.loanNumber
          == 'ML-' + string(request.time.year()) + '-'
            + string(getAfter(
              /databases/$(database)/documents/loanCounters/$(request.time.year())
            ).data.sequence);

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'lastReminderAt', 'returnedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.borrowerId == resource.data.borrowerId
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.requestId == resource.data.requestId
        && (
          (request.auth.uid == resource.data.borrowerId
            && resource.data.status == 'active'
            && request.resource.data.status == 'return_pending_confirmation'
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
              .data.borrowStatus == 'return_pending_confirmation')
          || (request.auth.uid == resource.data.ownerId
            && resource.data.status == 'return_pending_confirmation'
            && request.resource.data.status == 'returned'
            && request.resource.data.returnedAt == request.time
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId))
              .data.borrowStatus == 'available')
          || (request.auth.uid == resource.data.ownerId
            && resource.data.status == 'active'
            && request.resource.data.status == resource.data.status
            && request.resource.data.lastReminderAt == request.time
            && request.resource.data.updatedAt == request.time
            && (!resource.data.keys().hasAny(['lastReminderAt'])
              || request.time > resource.data.lastReminderAt + duration.value(24, 'h')))
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // loanCounters — monotonic human-readable Loan # allocator
    // ---------------------------------------------------------------

    match /loanCounters/{year} {
      allow get: if isSignedIn();
      allow list: if false;

      function linkedActiveLoan(next) {
        return next.lastRequestId is string
          && requestInAfter(next.lastRequestId, 'active')
          && existsAfter(/databases/$(database)/documents/loans/$(next.lastRequestId))
          && getAfter(/databases/$(database)/documents/loans/$(next.lastRequestId)).data.borrowerId
            == request.auth.uid
          && getAfter(/databases/$(database)/documents/loans/$(next.lastRequestId)).data.loanNumber
            == 'ML-' + year + '-' + string(next.sequence);
      }

      allow create: if isSignedIn()
        && year == string(request.time.year())
        && request.resource.data.sequence == 1
        && linkedActiveLoan(request.resource.data);

      allow update: if isSignedIn()
        && year == string(request.time.year())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sequence', 'lastRequestId', 'updatedAt'])
        && request.resource.data.sequence == resource.data.sequence + 1
        && linkedActiveLoan(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // reviews + likes + comments
    // ---------------------------------------------------------------

    match /reviews/{reviewId} {
      function countersOnlyChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'commentsCount']);
      }

      allow read: if canReadPosts(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.visibility in ['public', 'signed_in', 'followers_collaborators']
        && request.resource.data.visibility == postVisibility(request.auth.uid)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0;

      // FIX: use existsAfter() to prove the counter move is backed by a
      // real like/comment doc in the same batch.
      allow update: if isSignedIn()
        && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['body', 'rating', 'category', 'updatedAt', 'visibility'])
            && hasCurrentPostVisibility(request.auth.uid, request.resource.data)
            && request.resource.data.likesCount == resource.data.likesCount
            && request.resource.data.commentsCount == resource.data.commentsCount)
          || isAdmin()
          || (
            countersOnlyChanged()
            && request.resource.data.likesCount >= 0
            && request.resource.data.commentsCount >= 0
            && boundedByOne(resource.data.likesCount, request.resource.data.likesCount)
            && boundedByOne(resource.data.commentsCount, request.resource.data.commentsCount)
            && (
              // Like added
              (request.resource.data.likesCount == resource.data.likesCount + 1
                && !exists(/databases/$(database)/documents/reviews/$(reviewId)/likes/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/reviews/$(reviewId)/likes/$(request.auth.uid)))
              // Like removed
              || (request.resource.data.likesCount == resource.data.likesCount - 1
                && exists(/databases/$(database)/documents/reviews/$(reviewId)/likes/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/reviews/$(reviewId)/likes/$(request.auth.uid)))
              // Comment counter bump (best-effort; full fix needs Cloud Function)
              || (request.resource.data.commentsCount == resource.data.commentsCount + 1)
              // No counter change at all
              || (request.resource.data.likesCount == resource.data.likesCount
                && request.resource.data.commentsCount == resource.data.commentsCount)
            )
          )
        );

      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      match /likes/{likerId} {
        allow read: if canReadReview(reviewId);
        allow create, delete: if isSignedIn()
          && canReadReview(reviewId)
          && likerId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if canReadReview(reviewId);
        allow create: if isSignedIn()
          && canReadReview(reviewId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && canReadReview(reviewId)
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ---------------------------------------------------------------
    // shelves
    // ---------------------------------------------------------------

    match /shelves/{shelfId} {
      allow read: if isSignedIn() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // reports
    // ---------------------------------------------------------------

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // activityFeed
    // ---------------------------------------------------------------

    match /activityFeed/{eventId} {
      function isFeedPrivate(libraryId) {
        let userPath = /databases/$(database)/documents/users/$(libraryId);
        return exists(userPath)
          && get(userPath).data.keys().hasAll(['privacySettings'])
          && get(userPath).data.privacySettings is map
          && get(userPath).data.privacySettings.get('feed', 'collaborators') == 'private';
      }

      allow read: if isSignedIn()
        && (
          resource.data.libraryId == request.auth.uid
          || (isActivePartner(resource.data.libraryId) && !isFeedPrivate(resource.data.libraryId))
        );

      // FIX: only post into your own feed or an active partner's feed.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.libraryId == request.auth.uid
          || isActivePartner(request.resource.data.libraryId)
        );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // adminConfig — admin only
    // ---------------------------------------------------------------

    match /adminConfig/{configId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Admin Panel — Phase 6.1 (adminConfig/main, adminConfig/public)
    // ---------------------------------------------------------------

    match /adminConfig/main {
      allow read, write: if isAdmin();
    }

    match /adminConfig/public {
      allow read: if true;          // Public landing-page content only
      allow write: if isAdmin();
    }

    match /systemNotifications/{notificationId} {
      allow read, write: if isAdmin();   // Admin messaging; the backend fans out to users
    }

    // ---------------------------------------------------------------
    // systemBanners — announcements, modals, banners, and toasts
    // ---------------------------------------------------------------

    match /systemBanners/{bannerId} {
      function isValidBanner() {
        return request.resource.data.keys().hasAll([
            'title',
            'message',
            'severity',
            'displayType',
            'target',
            'active',
            'createdBy',
            'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 5000
          && request.resource.data.severity in ['info', 'warning', 'danger']
          && request.resource.data.displayType in ['modal', 'banner', 'toast']
          && request.resource.data.target in ['all', 'specific']
          && request.resource.data.active is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdBy.size() <= 200
          && request.resource.data.createdAt is timestamp
          && (!request.resource.data.keys().hasAny(['targetUserId'])
            || request.resource.data.targetUserId == null
            || (request.resource.data.targetUserId is string
              && request.resource.data.targetUserId.size() <= 200))
          && (!request.resource.data.keys().hasAny(['actionLink'])
            || request.resource.data.actionLink == null
            || (request.resource.data.actionLink is string
              && request.resource.data.actionLink.size() <= 2000))
          && (!request.resource.data.keys().hasAny(['actionLabel'])
            || request.resource.data.actionLabel == null
            || (request.resource.data.actionLabel is string
              && request.resource.data.actionLabel.size() <= 200))
          && (!request.resource.data.keys().hasAny(['expiresAt'])
            || request.resource.data.expiresAt == null
            || request.resource.data.expiresAt is timestamp);
      }

      allow read: if true;
      allow create: if isAdmin() && isValidBanner();
      allow update: if isAdmin() && isValidBanner();
      allow delete: if isAdmin();
    }

    // Admin dashboard read access. These blocks are OR-combined with the
    // owner/partner rules above, so non-admins gain no additional access.
    match /books/{bookId} {
      allow read: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin();
    }

    match /shelves/{shelfId} {
      allow read: if isAdmin();
    }

    // ---------------------------------------------------------------
    // adminAuditLog — append-only, written by admins, never mutated
    // ---------------------------------------------------------------

    match /adminAuditLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;   // immutable
    }
  }
}